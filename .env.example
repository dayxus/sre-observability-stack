# Runtime settings for the local lab.
#
#   cp .env.example .env      # scripts/up.sh does this for you when .env is missing
#
# .env is git-ignored. Image tags are deliberately NOT here: they live in versions.env
# so that a single file answers "what exactly is running in this stack".

# --- published host ports ------------------------------------------------------------
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
LOKI_PORT=3100
PROMTAIL_PORT=9080
BLACKBOX_EXPORTER_PORT=9115
NODE_EXPORTER_PORT=9100
SYNTHETIC_TARGET_HTTP_PORT=8080
SYNTHETIC_TARGET_HTTPS_PORT=8443

# --- Grafana -------------------------------------------------------------------------
# Local lab credential only. CI generates a random password per run and never reuses this.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=lab-admin

# --- Synthetic target / probe lab ----------------------------------------------------
# Days of validity for the self-signed certificate generated by scripts/gen-certs.sh.
# The certificate is regenerated on every run and never committed.
TLS_CERT_VALIDITY_DAYS=30
# The target drives a small amount of traffic against itself so that the golden-signals
# panels have data in a fresh lab. Set to false for a completely idle stack.
SELF_TRAFFIC_ENABLED=true
SELF_TRAFFIC_INTERVAL_SECONDS=2

# --- Smoke test ----------------------------------------------------------------------
# Seconds a single smoke check waits for its endpoint to answer.
SMOKE_HEAD_TIMEOUT=60
# Seconds the smoke test waits for the first scrape cycle and rule evaluation before it
# asserts that every target is up and the SLO rules have values.
SMOKE_WARMUP_TIMEOUT=240
