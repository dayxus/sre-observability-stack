# Pinned container images — the single source of truth for the stack.
#
# Every image referenced by docker-compose.yml resolves through this file: there is no
# ":latest" anywhere and no tag is typed twice. scripts/lib/env.sh exports these values
# before any docker compose call, and tests/test_compose.py fails the build if a service
# uses a tag that is not listed here.
#
# .github/workflows/maintenance.yml re-checks upstream release APIs every week, rewrites
# docs/versions.md, and opens an issue (instead of bumping) when a major is available.

PROMETHEUS_VERSION=v3.14.0
ALERTMANAGER_VERSION=v0.34.0
BLACKBOX_EXPORTER_VERSION=v0.28.0
NODE_EXPORTER_VERSION=v1.12.1
LOKI_VERSION=3.7.7
PROMTAIL_VERSION=3.6.11
GRAFANA_VERSION=13.2.2

# python:slim image used by the synthetic target that the stack scrapes and probes.
PYTHON_VERSION=3.13.15-slim
