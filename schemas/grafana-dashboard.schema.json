{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dayxus/sre-observability-stack/schemas/grafana-dashboard.schema.json",
  "title": "Grafana dashboard (provisioning subset)",
  "description": "Subset of the Grafana dashboard model that this repository relies on. It validates the fields that either break provisioning or silently produce an empty panel: identity, time range, panel type, grid position, datasource reference and non-empty targets. It is intentionally not the full Grafana model, so it stays readable and can be extended as the dashboards grow.",
  "type": "object",
  "required": ["title", "uid", "schemaVersion", "time", "templating", "panels"],
  "properties": {
    "title": {"type": "string", "minLength": 5},
    "uid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"},
    "description": {"type": "string", "minLength": 10},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "schemaVersion": {"type": "integer", "minimum": 30},
    "version": {"type": "integer", "minimum": 1},
    "editable": {"type": "boolean"},
    "refresh": {"type": "string", "pattern": "^(off|[0-9]+[smhd])$"},
    "time": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 2},
        "to": {"type": "string", "minLength": 1}
      }
    },
    "templating": {
      "type": "object",
      "required": ["list"],
      "properties": {
        "list": {"type": "array", "items": {"$ref": "#/$defs/variable"}}
      }
    },
    "panels": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/panel"}
    }
  },
  "$defs": {
    "datasourceRef": {
      "type": "object",
      "required": ["type", "uid"],
      "properties": {
        "type": {"enum": ["prometheus", "loki"]},
        "uid": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$"}
      }
    },
    "target": {
      "type": "object",
      "required": ["refId", "expr", "datasource"],
      "properties": {
        "refId": {"type": "string", "pattern": "^[A-Z]$"},
        "expr": {"type": "string", "minLength": 3},
        "legendFormat": {"type": "string"},
        "datasource": {"$ref": "#/$defs/datasourceRef"},
        "editorMode": {"enum": ["code", "builder"]},
        "instant": {"type": "boolean"},
        "range": {"type": "boolean"}
      }
    },
    "panel": {
      "type": "object",
      "required": ["id", "type", "title", "description", "datasource", "gridPos", "targets"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "type": {"enum": ["timeseries", "stat", "gauge", "table", "bargauge"]},
        "title": {"type": "string", "minLength": 3},
        "description": {"type": "string", "minLength": 15},
        "datasource": {"$ref": "#/$defs/datasourceRef"},
        "gridPos": {
          "type": "object",
          "required": ["h", "w", "x", "y"],
          "properties": {
            "h": {"type": "integer", "minimum": 4, "maximum": 24},
            "w": {"type": "integer", "minimum": 4, "maximum": 24},
            "x": {"type": "integer", "minimum": 0, "maximum": 23},
            "y": {"type": "integer", "minimum": 0}
          }
        },
        "fieldConfig": {"type": "object"},
        "options": {"type": "object"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/target"}
        }
      }
    },
    "variable": {
      "type": "object",
      "required": ["name", "type", "query", "current"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,30}$"},
        "label": {"type": "string"},
        "type": {"enum": ["query", "custom", "interval"]},
        "datasource": {"$ref": "#/$defs/datasourceRef"},
        "query": {
          "oneOf": [
            {"type": "string"},
            {"type": "object"}
          ]
        },
        "includeAll": {"type": "boolean"},
        "allValue": {"type": "string"},
        "multi": {"type": "boolean"},
        "refresh": {"type": "integer"},
        "current": {"type": "object", "required": ["text", "value"]}
      }
    }
  }
}
