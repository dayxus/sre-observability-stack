{
  "title": "Golden signals — synthetic target and node",
  "uid": "sre-golden-signals",
  "description": "The four golden signals of the synthetic workload the repository serves and probes: latency percentiles, traffic, errors and saturation of the node it runs on.",
  "tags": ["sre", "golden-signals", "latency", "lab"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-3h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "path",
        "label": "HTTP path",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(synthetic_http_requests_total, path)", "refId": "prometheus"},
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Traffic — request rate by path",
      "description": "Requests per second the synthetic target actually served, split by endpoint.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "targets": [
        {
          "refId": "A",
          "expr": "lab:requests:rate5m{path=~\"$path\"}",
          "legendFormat": "{{path}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors — 5xx ratio by path",
      "description": "Share of responses with a 5xx status. The /api/error endpoint is deliberate fault injection, so it is the one path expected to be red.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 0.01}
            ]
          }
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "targets": [
        {
          "refId": "A",
          "expr": "lab:errors:ratio_rate5m{path=~\"$path\"}",
          "legendFormat": "{{path}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency — p50, p95 and p99",
      "description": "Request duration percentiles computed from the target's own histogram, not from an external probe.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {"lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(synthetic_http_request_duration_seconds_bucket{path=~\"$path\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(synthetic_http_request_duration_seconds_bucket{path=~\"$path\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(synthetic_http_request_duration_seconds_bucket{path=~\"$path\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency — probe duration by job",
      "description": "Round trip time measured by the blackbox exporter, for comparison with the in-process histogram above.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": {"lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}},
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=~\"blackbox-.*\"}",
          "legendFormat": "{{job}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Traffic now (5m)",
      "description": "Total request rate across every instrumented endpoint of the synthetic target.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 18},
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(lab:requests:rate5m{path=~\"$path\"})",
          "legendFormat": "requests",
          "instant": true,
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Requests in flight",
      "description": "Concurrency reported by the target itself: a rising gauge with flat throughput is the first sign of saturation.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 18},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 5}
            ]
          }
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(synthetic_http_inflight_requests)",
          "legendFormat": "in flight",
          "instant": true,
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Saturation — node CPU busy",
      "description": "CPU time spent outside idle on the node that runs the stack, from node_exporter.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 18},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100)",
          "legendFormat": "cpu busy",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Saturation — root filesystem used",
      "description": "Disk usage of the volume that carries the Prometheus TSDB and the Loki chunks.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 18},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 70},
              {"color": "red", "value": 85}
            ]
          }
        },
        "overrides": []
      },
      "options": {"showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/rootfs\"}) * 100",
          "legendFormat": "used",
          "instant": true,
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    }
  ]
}
